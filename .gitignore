# ── Large ML model assets (local only) ────────────────────────────────────
model.onnx
voices.json
*.onnx
*.onnx.json
*.bin

# Piper voice model files (downloaded separately — see docs/DOCUMENTATION.md)
piper_voices/

# User-recorded voice cloning reference clips — personal audio, never commit
voice_samples/

# ── Python virtual environments ────────────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── Python cache & compiled bytecode ──────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.pypy_cache/

# ── Application & IDE configurations ──────────────────────────────────────
.env
.secrets
.idea/
.vscode/

# ── OS specific files ──────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store

# ── Docs & internal files ─────────────────────────────────────────────────
# Tracked documentation lives in docs/; any stray local file dropped there
# is ignored, so only real .md docs get committed from that folder.
TECHNICAL_WALKTHROUGH.md
docs/*
!docs/*.md
# Must come AFTER the negation above, or !docs/*.md would un-ignore it and
# publish an internal document to a public repository.
docs/TECHNICAL_WALKTHROUGH.md

# ── Launch scripts (keep start.ps1, ignore personal tunnel script) ─────────
run_bridge.ps1

# ── Remote control runtime artifacts (logs, generated keys) ────────────────
remote_logs/
*bridge_phone_ed25519*
bridge-pubkey.txt

# ── Secrets and credentials — NEVER commit ────────────────────────────────
*.pem
*.key
*.pfx
*.p12
id_rsa*
id_ed25519*
id_ecdsa*
*.kdbx
*.token
huggingface.token
.env.*
!.env.example

# ── Logs produced by any tool ─────────────────────────────────────────────
*.log

# ── Local tool / build caches (be explicit: some of these only
#    self-ignore via a .gitignore *inside* the folder, which breaks
#    the moment that file is deleted) ──────────────────────────────────────
.ruff_cache/
.mypy_cache/
.pytest_cache/

# ── Local virtualenvs ─────────────────────────────────────────────────────
activate/

